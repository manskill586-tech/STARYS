// STARYS — крюк защёлки, прототип v0.1.
//
// Надевается на крестовую качалку сервопривода SG90 внутри модуля.
// 0°  — крюк спрятан за гранью (защёлка открыта);
// 90° — крюк выходит через окно и цепляет штифт в окне соседа.
// Защёлки симметричны: у каждого модуля свой крюк и свой штифт,
// поэтому любые две грани стыкуются без «папы» и «мамы».

arm_len = 22;     // от оси сервопривода до зуба
arm_w = 8;
arm_t = 3;
hook_h = 7;       // высота зуба
hole_d = 4.8;     // посадка на вал SG90 (шлиц ~4.7 мм)
screw_d = 2.2;    // винт качалки
$fn = 40;

difference() {
  union() {
    hull() {
      cylinder(d = arm_w + 3, h = arm_t);
      translate([arm_len, 0, 0]) cylinder(d = arm_w, h = arm_t);
    }
    // зуб с фаской: при закрытии он скользит по штифту и заходит за него
    translate([arm_len - arm_w / 2, -arm_w / 2, 0])
      hull() {
        cube([arm_w, arm_w, arm_t]);
        translate([arm_w * 0.35, 0, 0]) cube([arm_w * 0.3, arm_w, hook_h + arm_t]);
      }
  }
  translate([0, 0, -1]) cylinder(d = hole_d, h = arm_t + 2);
  translate([0, 0, -1]) cylinder(d = screw_d, h = 20);
}
